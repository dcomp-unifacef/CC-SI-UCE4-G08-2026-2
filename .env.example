# =============================================================================
# Chic Dog - Sistema de Automação de Pedidos de Restaurante
# Modelo de variáveis de ambiente (.env.example)
# Copie este arquivo para .env e preencha com os valores do seu ambiente.
# =============================================================================

# -----------------------------------------------------------------------------
# Banco de dados (PostgreSQL)
# -----------------------------------------------------------------------------
DATABASE_URL="postgresql://postgres:prompt_solutions@localhost:5432/chicdog"
POSTGRES_PORT=5432

# -----------------------------------------------------------------------------
# API (Back-end)
# -----------------------------------------------------------------------------
PORT=3333

# -----------------------------------------------------------------------------
# Autenticação (JWT)
# -----------------------------------------------------------------------------
JWT_SECRET="troque-este-segredo-em-producao"
JWT_EXPIRES_IN="1d"
ADMIN_ROLE="Administrador"
CORS_ORIGIN="*"

# -----------------------------------------------------------------------------
# Seed (dados iniciais populados pelo comando `npm run db:seed`)
# -----------------------------------------------------------------------------
SEED_ADMIN_NOME="Administrador"
SEED_ADMIN_LOGIN="admin"
SEED_ADMIN_SENHA="admin123"

SEED_CLIENTE_NOME="Cliente Exemplo"
SEED_CLIENTE_LOGIN="cliente"
SEED_CLIENTE_SENHA="cliente123"

SEED_GARCOM_NOME="Garçom Exemplo"
SEED_GARCOM_LOGIN="garcom"
SEED_GARCOM_SENHA="garcom123"

SEED_COZINHEIRO_NOME="Cozinheiro Exemplo"
SEED_COZINHEIRO_LOGIN="cozinheiro"
SEED_COZINHEIRO_SENHA="cozinheiro123"
