generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model TipoUsuario {
  idTipoUsuario Int       @id @default(autoincrement())
  nome          String    @db.VarChar(50)
  usuarios      Usuario[] @relation("TipoUsuarioToUsuario")

  @@map("tipoUsuario")
}

model Usuario {
  idUsuario      Int         @id @default(autoincrement())
  nome           String      @db.VarChar(80)
  loginUsuario   String      @unique(map: "unq_login") @db.VarChar(80)
  senha          String      @db.VarChar(255)
  statusUsuario  Boolean
  idTipoUsuario  Int
  pedidosCliente Pedido[]    @relation("ClienteToPedido")
  pedidosGarcom  Pedido[]    @relation("GarcomToPedido")
  pedidosCozinheiro Pedido[] @relation("CozinheiroToPedido")
  tipoUsuario    TipoUsuario @relation("TipoUsuarioToUsuario", fields: [idTipoUsuario], references: [idTipoUsuario], onUpdate: NoAction)

  @@map("usuario")
}

model Pedido {
  idPedido      Int          @id @default(autoincrement())
  valorTotal    Decimal      @default(0) @db.Decimal(10, 2)
  dataHora      DateTime     @default(now())
  statusPedido  String       @default("Pendente") @db.VarChar(80)
  tempoEstimado Int?
  idCliente     Int
  idGarcom      Int
  idCozinheiro  Int?
  itens         ItemPedido[]
  pagamento     Pagamento?
  cliente       Usuario      @relation("ClienteToPedido", fields: [idCliente], references: [idUsuario], onDelete: Restrict, onUpdate: NoAction)
  garcom        Usuario      @relation("GarcomToPedido", fields: [idGarcom], references: [idUsuario], onDelete: Restrict, onUpdate: NoAction)
  cozinheiro    Usuario?     @relation("CozinheiroToPedido", fields: [idCozinheiro], references: [idUsuario], onDelete: SetNull, onUpdate: NoAction)

  @@index([statusPedido])
  @@index([idCliente])
  @@index([idGarcom])
  @@index([idCozinheiro])
  @@map("pedido")
}

model Pagamento {
  idPagamento    Int      @id @default(autoincrement())
  valor          Decimal  @db.Decimal(10, 2)
  dataHora       DateTime @default(now())
  formaPagamento String   @db.VarChar(80)
  status         String   @default("Pago") @db.VarChar(80)
  idPedido       Int      @unique(map: "unq_pagamento_pedido")
  pedido         Pedido   @relation(fields: [idPedido], references: [idPedido], onDelete: Cascade, onUpdate: NoAction)

  @@map("pagamento")
}

model Produto {
  idProduto   Int          @id @default(autoincrement())
  nome        String       @db.VarChar(80)
  preco       Decimal      @db.Decimal(10, 2)
  descricao   String       @db.VarChar(100)
  disponivel  Boolean      @default(true)
  itensPedido ItemPedido[]

  @@map("produto")
}

model ItemPedido {
  idItemPedido Int     @id @default(autoincrement())
  subTotal     Decimal @db.Decimal(10, 2)
  quantidade   Int
  valorUnit    Decimal @db.Decimal(10, 2)
  idProduto    Int
  idPedido     Int
  pedido       Pedido  @relation(fields: [idPedido], references: [idPedido], onDelete: Cascade, onUpdate: NoAction)
  produto      Produto @relation(fields: [idProduto], references: [idProduto], onDelete: Restrict, onUpdate: NoAction)

  @@unique([idPedido, idProduto])
  @@index([idPedido])
  @@index([idProduto])
  @@map("itemPedido")
}
