// Gera o Prisma Client usado pela API, pelos serviços e pelo script de seed.
generator client {
  provider = "prisma-client-js"
}

// Configura o banco PostgreSQL; a URL de conexão é fornecida pelo Prisma Config.
datasource db {
  provider = "postgresql"
}

// Perfis de acesso disponíveis e a relação inversa com os usuários associados.
model TipoUsuario {
  // Identificador numérico gerado automaticamente para o perfil.
  idTipoUsuario Int       @id @default(autoincrement())
  // Nome exibido para o perfil (por exemplo, Administrador ou Cliente).
  nome          String    @db.VarChar(50)
  // Usuários que possuem este perfil; o nome identifica a relação no Prisma.
  usuarios      Usuario[] @relation("TipoUsuarioToUsuario")

  // Mantém o nome da tabela compatível com o banco existente.
  @@map("tipoUsuario")
}

// Dados de autenticação e relações dos usuários com pedidos e perfis.
model Usuario {
  idUsuario      Int         @id @default(autoincrement())
  nome           String      @db.VarChar(80)
  loginUsuario   String      @unique(map: "unq_login") @db.VarChar(80)
  senha          String      @db.VarChar(255)
  statusUsuario  Boolean
  idTipoUsuario  Int
  pedidosCliente Pedido[]    @relation("ClienteToPedido")
  pedidosGarcom  Pedido[]    @relation("GarcomToPedido")
  tipoUsuario    TipoUsuario @relation("TipoUsuarioToUsuario", fields: [idTipoUsuario], references: [idTipoUsuario], onUpdate: NoAction)

  // Mapeia o modelo para a tabela física já existente no PostgreSQL.
  @@map("usuario")
}

// Pedido de uma mesa, com itens, pagamento opcional e participantes opcionais.
model Pedido {
  idPedido     Int          @id @default(autoincrement())
  valorTotal   Decimal      @db.Decimal(10, 2)
  dataHora     DateTime     @default(now())
  statusPedido String       @db.VarChar(80)
  numeroMesa   Int
  idCliente    Int?
  idGarcom     Int?
  motivoCancelamento String? @db.VarChar(255)
  itens        ItemPedido[]
  pagamento    Pagamento?
  cliente      Usuario?     @relation("ClienteToPedido", fields: [idCliente], references: [idUsuario], onUpdate: NoAction)
  garcom       Usuario?     @relation("GarcomToPedido", fields: [idGarcom], references: [idUsuario], onUpdate: NoAction)

  // Preserva o nome físico da tabela usado pelas migrações e repositórios.
  @@map("pedido")
}

// Pagamento associado a um pedido; o índice único implementa a relação 1:1.
model Pagamento {
  idPagamento    Int      @id @default(autoincrement())
  valor          Decimal  @db.Decimal(10, 2)
  dataHora       DateTime @default(now())
  formaPagamento String   @db.VarChar(80)
  status         String   @db.VarChar(80) @default("Pago")
  idPedido       Int      @unique(map: "unq_pagamento_pedido")
  pedido         Pedido   @relation(fields: [idPedido], references: [idPedido], onUpdate: NoAction)

  // Nome físico da tabela no banco PostgreSQL.
  @@map("pagamento")
}

// Solicitações de pagamento feitas pelo cliente e exibidas à equipe.
model NotificacaoPagamento {
  idNotificacao   Int      @id @default(autoincrement())
  idPedido        Int
  numeroMesa      Int
  metodoPagamento String   @db.VarChar(50)
  status          String   @db.VarChar(20) @default("PENDENTE")
  dataHora        DateTime @default(now())
  lida            Boolean  @default(false)

  // Nome físico da tabela no banco PostgreSQL.
  @@map("notificacaoPagamento")
}

// Catálogo de itens oferecidos, incluindo preço, imagem e disponibilidade.
model Produto {
  idProduto   Int          @id @default(autoincrement())
  nome        String       @db.VarChar(80)
  preco       Decimal      @db.Decimal(10, 2)
  descricao   String       @db.VarChar(100)
  imagem      String       @db.VarChar(255)
  disponivel  Boolean      @default(true)
  itensPedido ItemPedido[]

  // Nome físico da tabela no banco PostgreSQL.
  @@map("produto")
}

// Produto incluído em um pedido, com quantidade e valores registrados.
model ItemPedido {
  idItemPedido Int     @id @default(autoincrement())
  subTotal     Decimal @db.Decimal(10, 2)
  quantidade   Int
  valorUnit    Decimal @db.Decimal(10, 2)
  idProduto    Int
  idPedido     Int
  pedido       Pedido  @relation(fields: [idPedido], references: [idPedido], onUpdate: NoAction)
  produto      Produto @relation(fields: [idProduto], references: [idProduto], onUpdate: NoAction)

  // Nome físico da tabela no banco PostgreSQL.
  @@map("itemPedido")
}
