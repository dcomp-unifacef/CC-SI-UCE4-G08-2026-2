# =============================================================================
# Chic Dog - Front-end (React + Vite)
# Modelo de variáveis de ambiente (.env.example)
# Copie este arquivo para .env e preencha com os valores do seu ambiente.
# =============================================================================

# URL base da API do back-end.
# Em desenvolvimento (vite dev), o proxy do Vite (vite.config.ts) encaminha
# /api para http://localhost:3333, então esta variável pode ficar vazia.
# Em produção (vite build), defina com a URL do back-end, ex.:
#   VITE_API_URL=https://api.chicdog.com
VITE_API_URL=
