{
  "name": "restaurant-automation-system",
  "version": "1.0.0",
  "description": "Sistema de automação de pedidos de restaurante (UCE - Grupo 08)",
  "main": "dist/src/app.js",
  "scripts": {
    "dev": "prisma migrate deploy && tsx prisma/seed.ts && tsx Back-End/src/app.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/src/app.js",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.tools.json",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "node --import tsx --test Back-End/tests/errors.test.ts Back-End/tests/jwt.test.ts Back-End/tests/validation.test.ts",
    "db:seed": "tsx prisma/seed.ts",
    "db:migrate": "prisma migrate deploy"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/telinii/Restaurant-Automation-System.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/telinii/Restaurant-Automation-System/issues"
  },
  "homepage": "https://github.com/telinii/Restaurant-Automation-System#readme",
  "engines": {
    "node": ">=20.19"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "bcryptjs": "^3.0.3",
    "dotenv": "^18.0.3",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.23.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.20.4",
    "eslint": "^9.0.0",
    "prisma": "^7.10.0",
    "tsx": "^4.23.13",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.0.0"
  }
}
